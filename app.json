{
  "expo": {
    "name": "LightCycles",
    "slug": "LightCycles",
    "version": "1.0.0",
    "scheme": "lightcycles",
    "description": "A local multiplayer Tron/lightcycles pass-and-play game",
    "orientation": "default",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/dark-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jayrdeaton.LightCycles",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/images/dark-icon.png",
        "light": "./assets/images/light-icon.png"
      }
    },
    "android": {
      "package": "com.jayrdeaton.lightcycles"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/dark-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    },
    "owner": "jayrdeaton"
  }
}
